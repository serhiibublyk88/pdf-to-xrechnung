NODE_ENV=development
PORT=3000

# DATABASE_URL credentials must match the Compose Postgres values.
POSTGRES_USER=pdf_to_xrechnung
POSTGRES_PASSWORD=pdf_to_xrechnung
POSTGRES_DB=pdf_to_xrechnung
DATABASE_URL=postgresql://pdf_to_xrechnung:pdf_to_xrechnung@localhost:5432/pdf_to_xrechnung

REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=pdf-to-xrechnung

LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.8:27b-mlx
LLM_REQUEST_TIMEOUT_MS=30000

STORAGE_PATH=./data/uploads

KOSIT_VALIDATOR_URL=http://localhost:8081
KOSIT_REQUEST_TIMEOUT_MS=30000

RETENTION_HOURS=2
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLEANUP_INTERVAL_MINUTES=10
MAX_UPLOAD_MB=10
MAX_PAGES=30
RATE_LIMIT_PER_HOUR=20
# Set direct access to 0; deployed proxy counts must match the trusted chain.
TRUSTED_PROXY_HOPS=0

NATIVE_TEXT_MIN_CHARS_PER_PAGE=50
NATIVE_TEXT_TIMEOUT_MS=30000
OCR_MIN_CHARS_PER_PAGE=50
OCR_MIN_MEAN_CONFIDENCE=80
OCR_TIMEOUT_MS=15000 # per page
MAX_EXTRACTED_TEXT_CHARS=500000
