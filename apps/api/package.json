{
  "name": "@pdf-to-xrechnung/api",
  "version": "0.0.1",
  "description": "PDF invoice -> LLM extraction -> deterministic validation -> XRechnung (EN 16931)",
  "author": "Serhii Bublyk",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"src/**/*.mjs\" \"test/**/*.ts\" \"test/**/*.mjs\" \"evals/**/*.ts\" \"*.ts\" \"*.mjs\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test,evals}/**/*.ts\" \"{src,test}/**/*.mjs\" \"*.ts\" \"*.mjs\"",
    "lint:fix": "eslint \"{src,test,evals}/**/*.ts\" \"{src,test}/**/*.mjs\" \"*.ts\" \"*.mjs\" --fix",
    "pretypecheck": "npm run build --prefix ../../packages/contracts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build --prefix ../../packages/contracts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:integration": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-integration.json --runInBand",
    "test:e2e": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json --runInBand",
    "eval:generate": "ts-node evals/generate-golden-set.ts",
    "eval": "ts-node evals/run.ts",
    "eval:render": "ts-node evals/render.ts",
    "eval:validate": "ts-node evals/validate-golden-set.ts"
  },
  "dependencies": {
    "@e-invoice-eu/core": "^3.2.0",
    "@google/genai": "^2.16.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@pdf-to-xrechnung/contracts": "*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bullmq": "^6.0.9",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.11.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^4.6.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.9.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/evals",
      "<rootDir>/test/support"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
